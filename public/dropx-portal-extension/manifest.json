{
  "manifest_version": 3,
  "name": "Dropx Portal Helper",
  "version": "1.0.0",
  "description": "Run IOCL/BPCL fuel downloads from the Dropx dashboard using this PC’s internet — no PowerShell.",
  "permissions": ["storage", "tabs", "windows", "scripting"],
  "host_permissions": [
    "https://dashboard.dropxlogistics.com/*",
    "https://beta.iocxtrapower.com/*",
    "https://hellobpcl.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.dropxlogistics.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-dashboard.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://beta.iocxtrapower.com/*"],
      "js": ["content-iocl.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://hellobpcl.in/*"],
      "js": ["content-bpcl.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Dropx Portal Helper",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
